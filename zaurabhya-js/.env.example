# Razorpay (https://dashboard.razorpay.com/app/keys)
# Required to enable online checkout. Without these, checkout will save
# the order but skip payment collection.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay webhook (https://dashboard.razorpay.com/app/webhooks) - set this
# up pointing at <SITE_URL>/api/checkout/webhook, subscribed to the
# payment.captured and payment.failed events, and paste the secret shown
# there. Without this, an order can get stuck as "created" if the browser
# closes right after a successful payment (the client-side handler never
# gets to confirm it) — the webhook is the reliable fallback.
RAZORPAY_WEBHOOK_SECRET=

# PayU (https://onboarding.payu.in/) - TODO: dummy/placeholder, replace with
# real merchant key + salt before going live. Without these, the PayU
# payment option will save the order but skip payment collection.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_BASE_URL=https://test.payu.in/_payment

# Public site URL, used to build PayU's success/failure callback URLs and the
# links in pre-booking emails. On Hostinger set it to https://www.zaurabhya.com
SITE_URL=http://localhost:3000

# SMTP (form lead notifications)
# Required to email wholesale/export/dealer form submissions. Without these,
# submissions are still saved to disk but no email is sent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
WHOLESALE_NOTIFICATION_EMAIL=

# Where checkout/payment error alerts (Razorpay failures, signature
# mismatches, etc.) are sent. Defaults to lscctony@gmail.com if unset.
ALERT_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Product pre-booking (/products/dosa-rice, /products/malabar-tamarind)
# ---------------------------------------------------------------------------

# MySQL database that stores pre-booking orders and settings. Create it in
# hPanel > Databases > Management. From the deployed app the host is always
# 127.0.0.1 (not the srvNNNN.hstgr.io name, which is for remote access only).
# Either give one URL (URL-encode special characters in the password):
DATABASE_URL=
# ...or the separate parts (easier when the password has symbols in it):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Leave all of the above empty on your own computer: "npm run dev" then uses a
# local SQLite file (data/prebooking.sqlite). In production the app refuses to
# take orders without MySQL, because files inside the app folder are replaced
# on every Hostinger deploy.

# Where "payment to verify" and "new paid order" emails are sent.
ADMIN_ORDER_EMAIL=lscctony@gmail.com

# Password for /admin (orders, payment verification, shipping settings).
# At least 10 characters. /admin is disabled while this is empty.
ADMIN_PASSWORD=
# Optional: random string used to sign the admin session cookie. If empty, a
# key derived from ADMIN_PASSWORD is used.
ADMIN_SESSION_SECRET=

# Note: the UPI ID that receives payments, each product's price per KG and minimum quantity,
# shipping rates and tax are NOT environment variables. They are edited at
# /admin/settings and stored in the database.
